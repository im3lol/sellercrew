# NOTE: with Next dev (Turbopack), the relative form below can resolve
# differently at runtime vs. the Prisma CLI ("Unable to open the database file").
# If you hit that, use an ABSOLUTE path, e.g. DATABASE_URL="file:C:/path/to/project/db/custom.db"
DATABASE_URL="file:./db/custom.db"
# Secret used to sign session cookies. Use a long random value (>= 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_WORKFLOW_MODEL="gpt-5.4-mini"
OPENROUTER_API_KEY=""
OPENROUTER_WORKFLOW_MODEL="google/gemini-2.5-flash"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
