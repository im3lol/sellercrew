# PostgreSQL (Supabase). Use the POOLER, not the direct host (direct is IPv6-only).
# DATABASE_URL = transaction pooler (6543) for the app; DIRECT_URL = session pooler (5432) for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Secret used to sign session cookies. Use a long random value (>= 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Dedicated admin console credentials. Store only a scrypt hash, never plaintext.
# Prefer ADMIN_PASSWORD_HASH_B64 (base64 of the hash); ADMIN_PASSWORD_HASH is a
# plain (non-base64) fallback for the same value.
ADMIN_EMAIL="admin@sellercrew.ai"
ADMIN_PASSWORD_HASH_B64=""
# ADMIN_PASSWORD_HASH=""   # optional fallback if you don't base64-encode the hash
ADMIN_SESSION_SECRET=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_WORKFLOW_MODEL="gpt-5.4-mini"
OPENROUTER_API_KEY=""
OPENROUTER_WORKFLOW_MODEL="qwen/qwen3.7-plus"
# OpenRouter image model (settings default). GEMINI_IMAGE_MODEL is the direct
# Google image model used by the image generator.
OPENROUTER_IMAGE_MODEL="google/gemini-2.5-flash-image"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image-preview"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk authentication. Enable Google as a social connection in Clerk Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/"

# Google Drive + Sheets OAuth (Google Cloud web application credentials).
# Local redirect URI: http://localhost:3000/api/google-drive/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=""

# Redis for the BullMQ background worker (e.g. Upstash, rediss://...).
# Can also be set from the admin dashboard (API Keys & Secrets) for the queue.
# NOTE: the multi-instance rate limiter reads REDIS_URL from THIS env var (not the
# admin secret) so the auth path never hits the DB; set it here for multi-instance.
# Leave blank to disable the queue (inline SSE) and use the in-memory rate limiter.
REDIS_URL=""
# Set to 1 on a host that has no worker (e.g. Vercel-only) to force SSE fallback.
WORKFLOW_QUEUE_DISABLED=""

# Number of trusted reverse proxies in front of the app. Used to pick the real
# client IP from x-forwarded-for for rate limiting (the leftmost entry is
# client-spoofable). 1 = a single proxy (Vercel/most PaaS). 0 = no proxy.
TRUSTED_PROXY_COUNT="1"
