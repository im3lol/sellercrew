// SellerCrew V2 Enterprise Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTH & USERS
// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  avatar        String?
  passwordHash  String?
  emailVerified Boolean  @default(false)
  role          String   @default("user")
  accountStatus String   @default("active") @map("account_status") // active | suspended
  suspendedAt   DateTime? @map("suspended_at")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships     OrganizationMember[]
  activityLogs    ActivityLog[]
  ownedOrgs       Organization[]      @relation("OrgOwner")
  googleDriveConnection GoogleDriveConnection?
}

// ============================================
// MULTI-TENANT ORGANIZATIONS
// ============================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId    String  @map("owner_id")
  owner      User    @relation("OrgOwner", fields: [ownerId], references: [id])

  members      OrganizationMember[]
  projects     Project[]
  subscription Subscription?
  credits      Credit?
  googleDriveSettings GoogleDriveSettings?
}

model GoogleDriveConnection {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  googleEmail           String?  @map("google_email")
  encryptedRefreshToken String   @map("encrypted_refresh_token")
  scope                 String
  connectedAt           DateTime @default(now()) @map("connected_at")
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoogleDriveSettings {
  id                    String   @id @default(cuid())
  organizationId        String   @unique @map("organization_id")
  sheetMode             String   @default("workspace") @map("sheet_mode") // workspace | global
  imageFolderMode       String   @default("workspace") @map("image_folder_mode") // workspace | global
  selectedSpreadsheetId String?  @map("selected_spreadsheet_id")
  selectedSpreadsheetName String? @map("selected_spreadsheet_name")
  selectedFolderId      String?  @map("selected_folder_id")
  selectedFolderName    String?  @map("selected_folder_name")
  rootFolderId          String?  @map("root_folder_id")
  workspaceFolderId     String?  @map("workspace_folder_id")
  workspaceSheetId      String?  @map("workspace_sheet_id")
  autoSync              Boolean  @default(true) @map("auto_sync")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           String   @default("member") // owner, admin, manager, member, viewer
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

// ============================================
// SUBSCRIPTIONS & BILLING
// ============================================

model Subscription {
  id             String   @id @default(cuid())
  organizationId String   @unique @map("organization_id")
  plan           String   @default("starter") // starter, pro, agency, enterprise
  status         String   @default("active")  // active, past_due, cancelled, expired
  startDate      DateTime @default(now()) @map("start_date")
  endDate        DateTime? @map("end_date")
  trialEndsAt    DateTime? @map("trial_ends_at")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Credit {
  id             String   @id @default(cuid())
  organizationId String   @unique @map("organization_id")
  balance        Int      @default(0)
  used           Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ============================================
// PROJECTS & LISTINGS
// ============================================

model Project {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  marketplace    String   @default("amazon") // amazon, ebay, walmart, etc.
  country        String   @default("US")
  status         String   @default("active") // active, archived, draft
  agentId        String   @default("ali") @map("agent_id")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listings     Listing[]
  agentRuns    AgentRun[]
}

model Listing {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  productName String?  @map("product_name")
  title       String?
  bullets     String   @default("[]") // JSON array of strings
  description String?
  keywords    String   @default("[]") // JSON array of strings
  status      String   @default("draft") // draft, generated, reviewed, published
  score       Int      @default(0) // compliance score
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets      Asset[]
  generations Generation[]
}

model Asset {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  fileUrl   String   @map("file_url")
  type      String   // image, video, document, infographic
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

// ============================================
// AI AGENTS & GENERATIONS
// ============================================

model Generation {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  agentId   String   @map("agent_id")
  input     String?
  output    String?
  tokens    Int      @default(0)
  cost      Int      @default(0) // credits consumed
  model     String?
  duration  Int      @default(0) // milliseconds
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model AgentRun {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  agent       String    // agent id (ali, raed, fares, etc.)
  status      String    @default("pending") // pending, running, completed, failed
  input       String?
  output      String?
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================
// ACTIVITY LOGS
// ============================================

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// POLICY KNOWLEDGE BASE (Saleem's compliance memory)
// Global, admin-managed. Uploaded .md policy docs are parsed into
// structured, deduplicated rules that Saleem references at review time.
// ============================================

model PolicyDocument {
  id           String   @id @default(cuid())
  title        String
  fileName     String   @map("file_name")
  rawMarkdown  String   @map("raw_markdown")
  status       String   @default("active") // active, archived
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rules PolicyRule[]
}

model PolicyRule {
  id            String   @id @default(cuid())
  documentId    String   @map("document_id")
  category      String   // health_medical_claims, restricted_prohibited_products, etc.
  title         String
  ruleText      String   @map("rule_text")
  severity      String   @default("medium") // low, medium, high, critical
  keywords      String   @default("[]")     // JSON array of strings
  fingerprint   String                       // normalized hash for exact-duplicate detection
  status        String   @default("active")  // active, duplicate, superseded, archived
  duplicateOfId String?  @map("duplicate_of_id")
  note          String?                       // why flagged (dedup/AI rationale)
  createdAt     DateTime @default(now())

  document PolicyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([status])
  @@index([fingerprint])
}

// ============================================
// ADMIN: SYSTEM SETTINGS & WORKFLOW METRICS
// ============================================

model SystemSetting {
  key       String   @id
  value     String   // JSON-encoded value
  updatedAt DateTime @updatedAt
}

// Server-side record of each completed/blocked workflow run, for the
// admin accuracy & system report.
model WorkflowRun {
  id                String   @id @default(cuid())
  userId            String?  @map("user_id")
  provider          String?
  model             String?
  status            String   @default("completed") // completed, blocked, failed
  blocked           Boolean  @default(false)
  policyStatus      String?  @map("policy_status")
  overallScore      Int      @default(0) @map("overall_score")
  qualityScore      Int      @default(0) @map("quality_score")
  seoScore          Int      @default(0) @map("seo_score")
  conversionScore   Int      @default(0) @map("conversion_score")
  complianceScore   Int      @default(0) @map("compliance_score")
  accuracyScore     Int      @default(0) @map("accuracy_score")
  hallucinationRisk Int      @default(0) @map("hallucination_risk")
  generatedImages   Int      @default(0) @map("generated_images")
  inputTokens       Int      @default(0) @map("input_tokens")
  outputTokens      Int      @default(0) @map("output_tokens")
  durationMs        Int      @default(0) @map("duration_ms")
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

// Background workflow job processed by the BullMQ worker. The full input
// (incl. images) and streamed progress/result live here; Redis only carries id.
model WorkflowJob {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  status    String   @default("queued") // queued, running, completed, blocked, failed
  input     String   // JSON ProductInput
  events    String   @default("[]") // JSON array of progress events
  result    String?  // JSON FullWorkflowResult
  error     String?
  // Credit lifecycle (so a crashed/stranded job can be refunded by the reaper).
  creditId  String?  @map("credit_id")
  charged   Boolean  @default(false)
  refunded  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
